[Unit]
Description=ChromaCade song composer backend (Add Your Own Song)
After=network.target

[Service]
Type=simple
# Path/user are per-device -- see chromacade.service's identical note.
# Update both lines to match whatever device/checkout this is actually
# installed on -- see docs/device-rebuild-guide.md.
ExecStart=/usr/bin/python3 -u /home/plink/ChromaCade/song_editor_server.py
WorkingDirectory=/home/plink/ChromaCade
# Deliberately NOT root, unlike chromacade.service -- this process
# never touches GPIO/PWM/audio hardware, only the filesystem (writing
# into user-songs/) and a localhost-only HTTP socket. Runs as whatever
# user owns the checkout so it can write user-songs/ without needing
# elevated permissions for that either.
User=plink

Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
