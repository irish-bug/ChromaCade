[Unit]
Description=ChromaCade unified app (play/menu/Tutor/Simon)
After=sound.target
# StartLimit* belong in [Unit], not [Service] -- systemd silently
# ignores them in the wrong section ("Unknown key", confirmed live
# 2026-08-16), which meant the crash-loop cap below wasn't actually
# active until this got fixed. Caps restarts at 5/60s so a truly
# broken state fails loudly (journalctl will show it) instead of
# silently crash-looping forever.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
# Path/user are per-device -- these were /home/shane/ChromaCade (unit #1's
# builder account) until 2026-08-20, never updated when unit #1 was lost and
# unit #2 (plinkplonk, checkout owned by user "plink") became current. Update
# both lines to match whatever device/checkout this is actually installed
# on -- see docs/device-rebuild-guide.md for plinkplonk's current values.
ExecStart=/usr/bin/python3 -u /home/plink/ChromaCade/chromacade.py
WorkingDirectory=/home/plink/ChromaCade
# Also per-device, added 2026-08-28 -- see oled_display.py's own
# comment. plinkplonk's OLED is mounted opposite chromacade's; this
# device's value is 180 (the default oled_display.py falls back to if
# this line is missing entirely, kept explicit here anyway rather than
# relying on the fallback). chromacade's own chromacade.service must
# set this to 0 instead -- see docs/device-rebuild-guide.md.
Environment=CHROMACADE_OLED_ROTATION=180
# root, not the checkout owner above -- needed for the LED ring/strip's
# PWM/DMA access (neopixel), not for GPIO/I2C/audio in general, which a
# normal user can get via group membership instead (gpio/i2c/audio groups).
# See docs/open-questions.md's "dedicated non-root user" entry -- still
# open, deliberately not resolved by this file.
User=root

# Auto-restart safety net -- added 2026-08-16 specifically because a
# real crash (heap corruption from concurrent FluidSynth access, see
# audio_engine.py's ChromaCadeAudio._lock) was found and fixed THIS
# session. That specific bug is fixed, but once this ships to the
# kids' house there's no guarantee some other not-yet-found crash
# won't happen, and no one there can SSH in or power-cycle it on the
# spot -- auto-restart means a crash becomes a ~3s hiccup instead of a
# dead instrument.
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
