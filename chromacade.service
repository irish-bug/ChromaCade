[Unit]
Description=ChromaCade unified app (play/menu/Tutor/Simon)
After=sound.target
# StartLimit* belong in [Unit], not [Service] -- systemd silently
# ignores them in the wrong section ("Unknown key", confirmed live
# 2026-08-16), which meant the crash-loop cap below wasn't actually
# active until this got fixed. Caps restarts at 5/60s so a truly
# broken state fails loudly (journalctl will show it) instead of
# silently crash-looping forever.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/python3 -u /home/shane/ChromaCade/chromacade.py
WorkingDirectory=/home/shane/ChromaCade
User=root

# Auto-restart safety net -- added 2026-08-16 specifically because a
# real crash (heap corruption from concurrent FluidSynth access, see
# audio_engine.py's ChromaCadeAudio._lock) was found and fixed THIS
# session. That specific bug is fixed, but once this ships to the
# kids' house there's no guarantee some other not-yet-found crash
# won't happen, and no one there can SSH in or power-cycle it on the
# spot -- auto-restart means a crash becomes a ~3s hiccup instead of a
# dead instrument.
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
